+////////////////////////////////////////////////////////////////////////////////////////
+// POVRAY_WASM_SINGLE_THREADED_VFE
+// The two methods below split WorkerThread()'s original message-loop body
+// and cleanup tail into caller-driven entry points, for use under the
+// thread-stub build (wasmi has no real threads). They live in the same
+// `namespace vfe` scope as the rest of the file.
+
+#ifdef POVRAY_WASM
+// Forward-declare MainThreadInit (global scope, defined in povray.cpp).
+extern void *MainThreadInit(void);
+
+namespace vfe {
+
+__attribute__((optnone)) void vfeSession::RunIterationBody() // POVRAY_WASM_OPTNONE
+{
+  if (m_WorkerThreadShutdownRequest) return;
+  if (m_BackendThreadExited) return;
+  /* try */
+  {
+    while (POVMS_ProcessMessages (pov::POVMS_GUI_Context, true, true) == kFalseErr)
+    {
+      m_MessageCount++ ;
+      ProcessFrontend () ;
+      if (m_RenderCancelRequested == true || m_RequestFlag != rqNoRequest || m_WorkerThreadShutdownRequest == true)
+        break ;
+    }
+    ProcessFrontend () ;
+    if (m_RenderCancelRequested)
+    {
+      m_RenderCancelled = true;
+      while (POVMS_ProcessMessages (pov::POVMS_GUI_Context, false, false) == kFalseErr)
+        ProcessFrontend () ;
+      ProcessFrontend () ;
+      if (ProcessCancelRender() == true)
+        m_RenderCancelRequested = false;
+    }
+    if (m_RequestFlag != rqNoRequest)
+    {
+      int rq = m_RequestFlag;
+      m_RequestFlag = rqNoRequest;
+      switch (rq)
+      {
+        case rqPauseRequest:  m_RequestResult = m_Frontend->Pause()  ? 1 : 0; break;
+        case rqResumeRequest: m_RequestResult = m_Frontend->Resume() ? 1 : 0; break;
+      }
+      m_RequestEvent.notify_all ();
+    }
+  }
+}
+
+void vfeSession::FinishWorkerThread()
+{
+  /* try */
+  {
+    delete m_Frontend;
+    m_Frontend = nullptr;
+    WorkerThreadShutdown();
+    m_Initialized = false;
+    m_BackendThread = nullptr;
+    povray_terminate();
+    POVMS_CloseContext (POVMS_Output_Context);
+    m_CurrentSessionTemporaryHack = nullptr;
+    m_WorkerThreadExited = true;
+    m_ShutdownEvent.notify_all ();
+  }
+}
+
+int vfeSession::InitDirect()
+{
+  // Replicate the full WorkerThread init as direct calls.
+  if (POVMS_Init() == false) return -1;
+  if (POVMS_OpenContext(const_cast<void **>(&pov::POVMS_GUI_Context)) != kNoErr) return -2;
+  if (POVMS_GetContextAddress(pov::POVMS_GUI_Context, const_cast<void **>(&pov::GUIThreadAddr)) != kNoErr) return -3;
+
+  // Create backend via direct call (global scope, defined in povray.cpp).
+  void *backendAddr = ::MainThreadInit();
+  if (!backendAddr) return -5;
+
+  // Set up RenderThreadAddr so the frontend can address the backend.
+  pov::RenderThreadAddr = (POVMSAddress)backendAddr;
+  POVMS_Output_Context = pov::POVMS_GUI_Context;
+
+  // Create console and frontend (mirrors WorkerThread's init sequence).
+  m_Console = std::shared_ptr<vfeConsole>(new vfeConsole(this, m_ConsoleWidth));
+  POVMS_Object obj;
+  m_Frontend = new VirtualFrontEnd(*this, POVMS_Output_Context,
+      (POVMSAddress)pov::RenderThreadAddr, obj, nullptr, m_Console);
+  if (m_Frontend == nullptr) return -6;
+  m_BackendState = m_Frontend->GetState();
+  m_Initialized = true;
+  return 0;
+}
+
+int vfeSession::DriveAdvanceStarting()
+{
+  if (m_Frontend == nullptr) return -1;
+  int err = m_Frontend->AdvanceToParser();
+  if (err != 0) return err;
+  if (m_Frontend->GetState() != m_BackendState)
+    StateChanged(m_Frontend->GetState());
+  return 0;
+}
+
+} // namespace vfe
+#endif // POVRAY_WASM
