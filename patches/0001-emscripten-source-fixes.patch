+
+// POVRAY_WASM_CHAR_TRAITS_USHORT
+// Specialize char_traits<unsigned short> by deriving from the same
+// __char_traits_base that libc++ uses for char_traits<char16_t>.
+// This ensures copy/move/assign/fill use the exact same internal
+// helpers, avoiding the SSO-corruption bug in a standalone impl.
+#if defined(__EMSCRIPTEN__)
+#include <string>
+#include <cstdint>
+namespace std {
+    template<>
+    struct char_traits<unsigned short>
+        : __char_traits_base<unsigned short, uint_least16_t,
+                             static_cast<uint_least16_t>(0xFFFF)>
+    {
+        static _LIBCPP_CONSTEXPR_SINCE_CXX17 int
+        compare(const char_type* __s1, const char_type* __s2, size_t __n) noexcept {
+            for (; __n; --__n, ++__s1, ++__s2) {
+                if (lt(*__s1, *__s2)) return -1;
+                if (lt(*__s2, *__s1)) return  1;
+            }
+            return 0;
+        }
+        static _LIBCPP_CONSTEXPR_SINCE_CXX17 size_t
+        length(const char_type* __s) noexcept {
+            size_t __len = 0;
+            for (; !eq(*__s, char_type(0)); ++__s) ++__len;
+            return __len;
+        }
+        static _LIBCPP_CONSTEXPR_SINCE_CXX17 const char_type*
+        find(const char_type* __s, size_t __n, const char_type& __a) noexcept {
+            for (; __n; --__n, ++__s) if (eq(*__s, __a)) return __s;
+            return nullptr;
+        }
+    };
+}
+#endif // __EMSCRIPTEN__
+
 #endif // POVRAY_BASE_CONFIGBASE_H
