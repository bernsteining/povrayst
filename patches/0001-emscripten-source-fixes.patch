+// Direct init — does what MainThreadFunction does but as a regular
+// function call (not through boost::thread which LTO DCEs).
+void *MainThreadInit()
+{
+    using namespace pov;
+    Initialize_Noise();
+    InitializePatternGenerators();
+    if (POVMS_OpenContext(const_cast<POVMSContext *>(&POV_RenderContext)) != kNoErr)
+        return POVMSInvalidAddress;
+    {
+        RenderBackend *backend = new RenderBackend(POV_RenderContext, ValidateFrontendAddress);
+        (void)backend;
+        POV_MEM_INIT();
+        POVMS_InstallReceiver((POVMSContext)POV_RenderContext,
+            ConnectToFrontend, kPOVMsgClass_BackendControl,
+            kPOVMsgIdent_InitInfo, nullptr);
+        POVMS_InstallReceiver((POVMSContext)POV_RenderContext,
+            DisconnectFromFrontend, kPOVMsgClass_BackendControl,
+            kPOVMsgIdent_Done, nullptr);
+    }
+    void *addr = nullptr;
+    POVMS_GetContextAddress(POV_RenderContext, &addr);
