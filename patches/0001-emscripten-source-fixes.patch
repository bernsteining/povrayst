+// between progress checks to advance rendering.
+//
+// Guard against recursive entry: if a dispatched handler ends up
+// calling PumpMainThread() again (via POVMS_Send wait loop), just
+// return immediately. The outer call will continue.
+void PumpMainThread()
+{
+    if (POV_RenderContext == nullptr) return;
+    if (POV_TerminateMainThread) return;
+    if (povray_wasm_pump_recursion > 0) return;  // prevent re-entry
+    povray_wasm_pump_recursion++;
+    (void)POVMS_ProcessMessages((POVMSContext)POV_RenderContext, true, true);
+    povray_wasm_pump_recursion--;
