+// try/catch). The backend receives and processes these messages
+// via PumpMainThread.
+namespace vfe {
+using namespace pov_frontend;
+
+int VirtualFrontEnd::AdvanceToParser()
+{
+  POVMSObject csMsg;
+  int e1 = POVMSObject_New(&csMsg, kPOVObjectClass_ControlData);
+  if (e1 != 0) return 1000 + e1;
+  int e2 = POVMSMsg_SetupMessage(&csMsg, kPOVMsgClass_BackendControl, kPOVMsgIdent_CreateScene);
+  if (e2 != 0) return 2000 + e2;
+  int e3 = POVMSMsg_SetDestinationAddress(&csMsg, backendAddress);
+  if (e3 != 0) return 3000 + e3;
+
+  POVMSObject csResult;
+  POVMSObject_New(&csResult, kPOVObjectClass_ResultData);
+  int e4 = POVMS_Send(::POVMS_Output_Context, &csMsg, &csResult, kPOVMSSendMode_WaitReply);
+  if (e4 != 0) return 4000 + e4;
+
+  state = kParsing;
+  return 0;
+}
